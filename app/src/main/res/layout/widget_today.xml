<?xml version="1.0" encoding="utf-8"?>
<!--
    「今天」小组件的外观。

    行程区里那一行样例是给桌面预览（以及刚放上桌面的那一瞬间）看的，
    第一次更新时会被真实行程整组替换掉，见 TodayWidget.views()。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- 头部：点一下打开应用；右边那个圆按钮直接进语音录入 -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_title"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/widget_today_date_placeholder"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_record"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_record_background"
            android:contentDescription="@string/widget_record"
            android:padding="7dp"
            android:src="@drawable/ic_widget_mic" />
    </LinearLayout>

    <!--
        这条分隔线用 LinearLayout 而不是 View：小组件里只允许用带 @RemoteView 标注的控件，
        普通的 View 会被启动器拒绝（Class not allowed to be inflated），
        结果是整块组件显示成「载入窗口小组件时出现问题」。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_divider"
        android:orientation="horizontal" />

    <!-- 行程区：代码在这里逐行贴行程 -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <include
            android:id="@+id/widget_sample_row"
            layout="@layout/widget_row" />
    </LinearLayout>

    <!-- 今天没有安排时 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_today_empty"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 还有几条没放下 -->
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
