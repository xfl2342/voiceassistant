<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 语音录入需要录音权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 调用 DeepSeek 解析行程需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 到点提醒需要发通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 提醒要像闹钟一样响：声音走闹钟通道，同时震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 14 起，全屏提醒（锁屏上直接亮起来的那一屏）要单独授权；
         没授权也能响，只是不会自动亮屏，会在通知栏里等 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 精确到分钟触发提醒；Android 12 起还需要用户在系统设置中允许 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 重启后重新注册提醒，否则重启一次提醒就再也不响了 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        声明我们要使用系统语音识别服务。
        Android 11 起应用默认看不到别的应用提供的服务，不声明这里
        SpeechRecognizer 会误判为“设备不支持语音识别”。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceAssistant">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VoiceAssistant"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 到点弹出来的那一屏；锁屏上直接亮起来，不用先解锁 -->
        <activity
            android:name=".reminder.ReminderAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:theme="@style/Theme.VoiceAssistant"
            android:turnScreenOn="true" />

        <!-- 闹钟到点时唤起，弹出通知 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 开机与应用更新后重新注册所有提醒 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：显示今天的行程 -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
    </application>

</manifest>
